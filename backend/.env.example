# Anthropic Messages-compatible gateway; actual model may not be Claude.
# Legacy variable names are retained; use a gateway-supported model such as MiniMax-M3.
# BASE_URL is the gateway origin or /v1 API base; do not append /messages.
CLAUDE_API_KEY=
CLAUDE_BASE_URL=https://newapi.iomgaa.online
CLAUDE_MODEL=
CLAUDE_API_VERSION=2023-06-01

# Set AI_API_FORMAT=openai to read OPENAI_* instead of CLAUDE_*.
# DeepSeek official Chat Completions example: https://api.deepseek.com/v1
AI_API_FORMAT=openai
OPENAI_API_KEY=
OPENAI_BASE_URL="https://api.deepseek.com/v1"
OPENAI_MODEL="deepseek-flash"
# Optional: low/high/max/none. DeepSeek official OpenAI mode defaults to low.
AI_THINKING_EFFORT=
# Per-provider-call timeout, from 1 to 120 seconds; default 120.
AI_TIMEOUT_SECONDS=120

# Qwen speech input (independent of the chat model). Set the key in the backend process environment.
QWEN_ASR_API_KEY=
# DASHSCOPE_API_KEY is also accepted when QWEN_ASR_API_KEY is empty.
QWEN_ASR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Workspace endpoint is also supported: https://<WorkspaceId>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
QWEN_ASR_MODEL=qwen3-asr-flash
QWEN_ASR_TIMEOUT_SECONDS=60
